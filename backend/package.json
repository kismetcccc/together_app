{
  "name": "together-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "mail": "node --env-file-if-exists=.env scripts/read-mail.mjs",
    "mail:check": "node --env-file-if-exists=.env scripts/check-smtp.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
